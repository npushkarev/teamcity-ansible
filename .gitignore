# Секреты и реальные inventory не публикуются.
inventory/hosts.yml
inventory/vault.yml
inventory/group_vars/*/vault.yml
inventory/host_vars/
.vault_pass*
*.retry
.fact_cache/
collections/
.DS_Store

# Backup старого TeamCity — только локально.
migration/*
!migration/README.md

# Сертификат и ключ https — только локально.
files/tls/*
!files/tls/README.md

# Java для агентов и собранный дистрибутив агента — только локально.
files/teamcity-agent/jdk/*
!files/teamcity-agent/jdk/.gitkeep
files/teamcity-agent/build/
